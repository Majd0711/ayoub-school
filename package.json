{
  "name": "horizons-school-monorepo",
  "version": "1.0.0",
  "description": "Horizons School website and admin panel",
  "main": "index.js",
  "scripts": {
    "start:backend": "cd horizons-school-backend && npm run start",
    "start:frontend": "cd horizons-school && npm run start",
    "dev:backend": "cd horizons-school-backend && npm run dev",
    "dev:frontend": "cd horizons-school && npm run start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "npm install && cd horizons-school && npm install && cd ../horizons-school-backend && npm install",
    "build": "cd horizons-school && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "school",
    "education",
    "website",
    "admin"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.2",
    "@mui/material": "^7.1.2",
    "@types/aos": "^3.0.7",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "boxicons": "^2.1.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "formik": "^2.4.6",
    "framer-motion": "^12.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "react-icons": "^5.5.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.6.2",
    "slugify": "^1.6.6",
    "yup": "^1.6.1"
  }
}
